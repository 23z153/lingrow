# Copy this file to .env and fill in real values before running the server.

# MongoDB connection string. Local example: mongodb://127.0.0.1:27017/lingrow_ai
# Atlas example: mongodb+srv://user:pass@cluster.mongodb.net/lingrow_ai
MONGO_URI=mongodb://127.0.0.1:27017/lingrow_ai

# Secret used to sign access-token JWTs. Use a long random string in production.
JWT_SECRET=change_this_to_a_long_random_string

# Access tokens are short-lived; the frontend silently exchanges the
# httpOnly refresh cookie for a new one when this expires.
ACCESS_TOKEN_EXPIRES_IN=15m

# How long the refresh-token cookie stays valid before the user has to log
# in again from scratch.
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# Port the API server listens on.
PORT=5000

# Set to "production" when deployed behind HTTPS — this makes the refresh
# cookie Secure (HTTPS-only). Leave as "development" for local http:// use.
NODE_ENV=development

# Used to build the link inside verification emails, e.g. https://app.lingrow.ai
FRONTEND_URL=http://localhost:5000

# --- SMTP (optional) ---
# If left blank, verification emails are logged to the server console
# instead of actually being sent — the link still works, it's just not
# delivered anywhere. Fill these in (e.g. with a free Mailtrap/SendGrid/SES
# account) to send real email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LinGrow AI <no-reply@lingrow.ai>

# Anthropic API key — powers the AI Tutor, debate/story scoring, and
# pronunciation feedback commentary (services/llmService.js).
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Two-Model Local AI Chatbot (RTX 3050 6GB Sequential Execution)
# Primary Generator: Qwen (qwen2.5:3b / qwen3:8b / qwen2.5:7b)
# Verifier: DeepSeek-R1 (deepseek-r1:1.5b / deepseek-r1:7b / deepseek-r1:8b)
OLLAMA_BASE_URL=http://127.0.0.1:11434
PRIMARY_MODEL=qwen2.5:3b
VERIFIER_MODEL=deepseek-r1:1.5b

# Comma separated list of origins allowed to call this API.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5500

